{
  "name": "bluey-windows",
  "productName": "Bluey",
  "version": "0.2.0",
  "description": "Bluey focus friend for Windows. Pairs with the Bluey iPhone or Android app.",
  "license": "Unlicense",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "bonjour-service": "^1.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.11.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "co.visionairy.googly.windows",
    "productName": "Bluey",
    "files": ["src/**", "renderer/**", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
